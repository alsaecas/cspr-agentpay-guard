# =============================================================================
# CSPR AgentPay Guard — Dashboard Environment
# =============================================================================

# App mode (mock only for now)
NEXT_PUBLIC_AGENTPAY_MODE=mock

# Demo backend: self-contained works on Vercel; external proxies to paid-api.
AGENTPAY_DEMO_BACKEND=self-contained

# Public dashboard URL used in request-bound demo receipts.
# Vercel sets VERCEL_URL automatically, so this is optional there.
AGENTPAY_PUBLIC_BASE_URL=http://localhost:3000

# Paid API base URL (only used when AGENTPAY_DEMO_BACKEND=external)
AGENTPAY_PAID_API_BASE_URL=http://127.0.0.1:4000

# Demo identity
AGENTPAY_DEFAULT_POLICY_ID=policy_demo_agent_001
AGENTPAY_DEFAULT_AGENT_ID=agent_research_001

# Target resource for demo flow (optional override)
AGENTPAY_TARGET_URL=http://localhost:3000/premium/parking-report/MAD-001

# Auto-settle after successful retrieval
AGENTPAY_AUTO_SETTLE=true
