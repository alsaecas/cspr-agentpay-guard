# =============================================================================
# CSPR AgentPay Guard — Environment
# =============================================================================
# Copy this file to .env and fill in values for your local setup.
# Never commit .env or secret key files.

# App mode: mock | casper-testnet
AGENTPAY_MODE=mock
AGENTPAY_DEMO_SEED=agentpay-demo

# Guarded x402 foundation. The official x402 SDK currently has no Casper
# scheme signer; real mode fails closed until a verified signer is injected.
X402_CASPER_NETWORK=casper:casper-test
X402_CASPER_ASSET=CSPR
X402_CASPER_FACILITATOR_URL=
X402_ALLOWED_FACILITATORS=
X402_CASPER_PAYEE=
# Native CSPR transfer minimum is chainspec-controlled; verify the current Testnet value.
X402_CASPER_PAYMENT_AMOUNT_MOTES=2500000000

# Casper network target
CASPER_NETWORK=casper-test
CASPER_RPC_URL=https://node.testnet.casper.network/rpc
CASPER_NODE_SSE_URL=
CASPER_DEPLOY_GAS_MOTES=500000000000
CASPER_PROOF_GAS_MOTES=5000000000
CASPER_TRANSFER_GAS_MOTES=100000000
CASPER_POLL_TIMEOUT_MS=120000
CASPER_POLL_INTERVAL_MS=3000
AGENTPAY_REAL_RESOURCE_URL=http://127.0.0.1:4000/premium/rwa/parking-asset/MAD-001
AGENTPAY_REAL_IDEMPOTENCY_PATH=.agentpay/submissions.real.json
# Separate durable replay state used by the paid API after RPC verification.
AGENTPAY_CONSUMED_TRANSACTIONS_PATH=.agentpay/consumed.real.json

# CSPR.cloud (indexing, streaming, event reads)
CSPR_CLOUD_AUTH_TOKEN=
CSPR_CLOUD_API_URL=
CSPR_CLOUD_STREAM_URL=

# Casper AgentPay contract hashes (populated after deployment)
CASPER_AGENTPAY_CONTRACT_PACKAGE_HASH=
CASPER_AGENTPAY_CONTRACT_HASH=
POLICY_REGISTRY_HASH=
MERCHANT_REGISTRY_HASH=
PAYMENT_ESCROW_HASH=

# Testnet account keys (required for real Casper Testnet mode)
CASPER_TESTNET_PUBLIC_KEY=
CASPER_TESTNET_SECRET_KEY_PATH=
CASPER_MERCHANT_PUBLIC_KEY=
CASPER_MERCHANT_ACCOUNT_HASH=

# Odra livenet values are optional for generated Odra CLI workflows.
ODRA_CASPER_LIVENET_NODE_ADDRESS=https://node.testnet.casper.network/rpc
ODRA_CASPER_LIVENET_EVENTS_URL=
ODRA_CASPER_LIVENET_CHAIN_NAME=casper-test
ODRA_CASPER_LIVENET_SECRET_KEY_PATH=
